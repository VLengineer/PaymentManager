# Database Strategy Pattern Configuration
DB_TYPE=sqlite  # Options: sqlite, postgresql

# PostgreSQL Configuration (used when DB_TYPE=postgresql)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bdds_payment_calendar

# SQLite Configuration (used when DB_TYPE=sqlite)
SQLITE_DB_PATH=./bdds_dev.db

# Application Settings
APP_ENV=development
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Ollama Configuration (Optional)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3
